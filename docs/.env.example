# Settings for compose.example.yml and compose.tls.example.yml.
#
#   cp .env.example .env && chmod 600 .env
#
# then fill in the REQUIRED values. They are empty on purpose: compose refuses to start
# while one is missing, instead of coming up with a placeholder password guarding your
# sealed SSH credentials. Never commit the filled-in file (.env is gitignored).

# --- REQUIRED, both files ---------------------------------------------------------

# Decrypts every stored SSH credential and MFA secret. Generate it once:
#   docker run --rm mar0ls/bladedr:0.9.6 -keygen
# and paste the BLADEDR_NODE_KEY value it prints (not public_key). Back it up
# separately from the database: lose it and the credentials are unrecoverable.
BLADEDR_NODE_KEY=

# Database password. Any long random string without '@', ':' or '/':
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- compose.tls.example.yml only --------------------------------------------------

# REQUIRED there. Initial admin password. In compose.example.yml it is optional: left
# empty, a password is generated and printed once in the server log.
BLADEDR_ADMIN_PASSWORD=

# Recommended. Name and IP the self-signed certificate is issued for, i.e. what you
# type into the browser. Empty falls back to localhost / 127.0.0.1, which only matches
# a console opened from the same machine. Changing them later needs ./tls deleted.
TLS_DNS=
TLS_IP=

# --- OPTIONAL ---------------------------------------------------------------------

# How monitored hosts reach this server. Needed for the eBPF sensor tier and for the
# isolate_host response playbook. Use a literal IP, not a DNS name. Scanning works
# without it.
# BLADEDR_SERVER_URL=https://203.0.113.10:8389

# compose.tls.example.yml only. Default 127.0.0.1 (loopback). 0.0.0.0 publishes the
# console on every interface: restrict it with a firewall first.
# BLADEDR_BIND_ADDRESS=0.0.0.0

# compose.tls.example.yml only. Host port for the console, default 8389. Use 443 to open
# https://<name>/ui without a port. Match it in BLADEDR_SERVER_URL if you set that.
# BLADEDR_PORT=443
